 "privacy": [
  {
   "data": "Product interaction",
   "apple": "NSPrivacyCollectedDataTypeProductInteraction",
   "play": "App activity: App interactions",
   "from": "sessions, level_*, tutorial_*, setting_change, screen_view, earn/spend_virtual_currency, ad_event, custom events"
  },
  {
   "data": "Crash data",
   "apple": "NSPrivacyCollectedDataTypeCrashData",
   "play": "App info and performance: Crash logs",
   "from": "pulse_error, pulse_exit"
  },
  {
   "data": "Performance data",
   "apple": "NSPrivacyCollectedDataTypePerformanceData",
   "play": "App info and performance: Diagnostics",
   "from": "pulse_perf, pulse_load"
  },
  {
   "data": "Other diagnostic data",
   "apple": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
   "play": "App info and performance: Diagnostics",
   "from": "ctx: os, device_model, device_tier, ram_mb, sdk, engine"
  },
  {
   "data": "Device ID",
   "apple": "NSPrivacyCollectedDataTypeDeviceID",
   "play": "Device or other IDs",
   "from": "ctx.install_id (random UUID per install; no IDFA, AAID, IDFV or Android ID)"
  },
  {
   "data": "User ID",
   "apple": "NSPrivacyCollectedDataTypeUserID",
   "play": "Personal info: User IDs",
